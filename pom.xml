<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.5</version>
        <relativePath/>
    </parent>

    <groupId>com.nimbus</groupId>
    <artifactId>nimbus-cloud</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>
    <description>nimbus-cloud 企业级网盘服务端</description>

    <modules>
        <module>nimbus-common</module>
        <module>nimbus-framework</module>
        <module>nimbus-module</module>
        <module>nimbus-server</module>
    </modules>

    <properties>
        <revision>1.0.0-jdk21-snapshot</revision>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <flatten-maven-plugin.version>1.5.0</flatten-maven-plugin.version>

        <mybatis-plus.version>3.5.12</mybatis-plus.version>
        <mysql.version>8.0.33</mysql.version>
        <druid.version>1.2.22</druid.version>
        <redisson.version>3.26.0</redisson.version>
        <sa-token.version>1.39.0</sa-token.version>
        <springdoc.version>2.3.0</springdoc.version>
        <hutool.version>5.8.35</hutool.version>
        <aws-sdk.version>2.28.22</aws-sdk.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- 三方依赖版本统一在此管理, 单一事实来源 -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <!-- 3.5.9+ 分页插件依赖的 jsqlparser 拆分为独立构件 -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-jsqlparser</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <dependency>
                <groupId>com.mysql</groupId>
                <artifactId>mysql-connector-j</artifactId>
                <version>${mysql.version}</version>
            </dependency>
            <dependency>
                <groupId>com.alibaba</groupId>
                <artifactId>druid-spring-boot-3-starter</artifactId>
                <version>${druid.version}</version>
            </dependency>
            <dependency>
                <groupId>org.redisson</groupId>
                <artifactId>redisson-spring-boot-starter</artifactId>
                <version>${redisson.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.dev33</groupId>
                <artifactId>sa-token-spring-boot3-starter</artifactId>
                <version>${sa-token.version}</version>
            </dependency>
            <!-- Sa-Token 会话/token 持久化到 Redis(jackson 序列化) -->
            <dependency>
                <groupId>cn.dev33</groupId>
                <artifactId>sa-token-redis-jackson</artifactId>
                <version>${sa-token.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.hutool</groupId>
                <artifactId>hutool-core</artifactId>
                <version>${hutool.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.hutool</groupId>
                <artifactId>hutool-crypto</artifactId>
                <version>${hutool.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.hutool</groupId>
                <artifactId>hutool-extra</artifactId>
                <version>${hutool.version}</version>
            </dependency>
            <!-- 对象存储(兼容 MinIO / 阿里云 OSS / 腾讯云 COS) -->
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>s3</artifactId>
                <version>${aws-sdk.version}</version>
            </dependency>

            <!-- 自研模块版本统一 -->
            <dependency>
                <groupId>com.nimbus</groupId>
                <artifactId>nimbus-common</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.nimbus</groupId>
                <artifactId>nimbus-json</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.nimbus</groupId>
                <artifactId>nimbus-mybatis</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.nimbus</groupId>
                <artifactId>nimbus-redisson</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.nimbus</groupId>
                <artifactId>nimbus-security</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.nimbus</groupId>
                <artifactId>nimbus-opendoc</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.nimbus</groupId>
                <artifactId>nimbus-log</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.nimbus</groupId>
                <artifactId>nimbus-storage</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.nimbus</groupId>
                <artifactId>nimbus-system</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.nimbus</groupId>
                <artifactId>nimbus-netdisk</artifactId>
                <version>${revision}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <!-- 仅 server 启动模块显式引用 -->
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <executions>
                        <execution>
                            <goals>
                                <goal>repackage</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <!-- 统一 revision 版本 -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>${flatten-maven-plugin.version}</version>
                <configuration>
                    <flattenMode>resolveCiFriendliesOnly</flattenMode>
                    <updatePomFile>true</updatePomFile>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>flatten.clean</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>